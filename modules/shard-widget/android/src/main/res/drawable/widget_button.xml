<?xml version="1.0" encoding="utf-8"?>
<!--
  Primary action, matching HudButton's `primary` variant: violet fill, md radius.
  The gradient runs violet → violetDeep the same way SHARD_GRADIENT does, so the
  one loud surface on the widget is the brand's, not Material's.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
  <gradient
      android:angle="270"
      android:startColor="@color/widget_violet"
      android:endColor="@color/widget_violet_deep"
      android:type="linear" />
  <corners android:radius="@dimen/hud_radius_md" />
</shape>
