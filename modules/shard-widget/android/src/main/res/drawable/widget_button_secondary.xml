<?xml version="1.0" encoding="utf-8"?>
<!--
  HudButton's `secondary` variant. Used for the optimistic "✓ Done" state: the
  tap already landed, so the button must stop soliciting another one — but it
  must not vanish either, or the card collapses and the acknowledgement reads as
  the widget having lost the task.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
  <solid android:color="@color/widget_panel_high" />
  <corners android:radius="@dimen/hud_radius_md" />
  <stroke android:width="1dp" android:color="@color/widget_border" />
</shape>
