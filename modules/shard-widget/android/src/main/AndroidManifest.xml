<?xml version="1.0" encoding="utf-8"?>
<!--
  Declared in the module's own manifest rather than the app's, so it is merged in
  automatically and survives a clean prebuild. Editing
  android/app/src/main/AndroidManifest.xml by hand would work until the next
  prebuild silently removed it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <receiver
        android:name="com.xavitech.shardwidget.ShardWidgetProvider"
        android:label="@string/widget_label"
        android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <!-- Custom actions the widget sends to itself: the completion tap and a
             forced refresh. Both are internal, hence exported=false. -->
        <action android:name="com.xavitech.shardwidget.ACTION_COMPLETE" />
        <action android:name="com.xavitech.shardwidget.ACTION_REFRESH" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/shard_widget_info" />
    </receiver>
  </application>
</manifest>
