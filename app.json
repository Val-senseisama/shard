{
  "expo": {
    "name": "shard",
    "slug": "shard",
    "version": "1.0.0",
    "scheme": "shard",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/app-icons/icon.png",
          "color": "#ffffff",
          "sounds": []
        }
      ],
      "expo-sqlite"
    ],
    "orientation": "portrait",
    "icon": "./assets/app-icons/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/app-icons/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xavitech.shard",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Shard needs access to your photo library to let you choose images for your shards and profile.",
        "NSCameraUsageDescription": "Shard needs access to your camera to let you take photos for your shards and profile."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icons/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.xavitech.shard",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "531fcf58-99c3-489a-8d13-6f738e65b42d"
      }
    }
  }
}
