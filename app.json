{
  "expo": {
    "name": "shard",
    "slug": "shard",
    "description": "Tell Shard a goal and it builds the plan: milestones, tasks and real dates scheduled around your week. Add a friend as your accountability partner so someone notices if you stop.",
    "version": "1.0.2",
    "scheme": "shard",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/app-icons/icon.png",
          "color": "#ffffff",
          "sounds": []
        }
      ],
      "expo-sqlite",
      "expo-updates"
    ],
    "orientation": "portrait",
    "icon": "./assets/app-icons/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/app-icons/Fractal shard(3).png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xavitech.shard",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Shard needs access to your photo library to let you choose images for your shards and profile.",
        "NSCameraUsageDescription": "Shard needs access to your camera to let you take photos for your shards and profile."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icons/icon.png",
        "backgroundColor": "#0a0a0f"
      },
      "package": "com.xavitech.shard",
      "versionCode": 3,
      "permissions": [
        "CAMERA"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "updates": {
      "url": "https://u.expo.dev/531fcf58-99c3-489a-8d13-6f738e65b42d",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "531fcf58-99c3-489a-8d13-6f738e65b42d"
      }
    }
  }
}
