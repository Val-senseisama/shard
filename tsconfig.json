{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",

    "baseUrl": ".",
    "paths": {
      "~/*": ["./*"],
      "@/*": ["./*"],
      "components/*": ["./components/*"],
      "hooks/*": ["./hooks/*"],
      "utils/*": ["./utils/*"],
      "assets/*": ["./assets/*"],
      "styles/*": ["./styles/*"],
      "types/*": ["./types/*"],
      "services/*": ["./services/*"],
      "contexts/*": ["./contexts/*"],
      "store/*": ["./store/*"],
    }
  }
}
